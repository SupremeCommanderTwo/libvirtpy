<!-- Owned by libvirtxml: storage pool capabilities. -->
<storagepoolCapabilities>
  <pool type='dir' supported='yes'>
    <volOptions>
      <defaultFormat type='raw'/>
      <enum name='targetFormatType'>
        <value>raw</value>
        <value>qcow2</value>
      </enum>
    </volOptions>
  </pool>
  <pool type='iscsi' supported='no'/>
</storagepoolCapabilities>
